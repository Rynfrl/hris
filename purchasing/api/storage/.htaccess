# Deny all direct web access to this folder (Apache 2.2 and 2.4).
# It only ever holds small per-IP rate-limit counters (see
# api/helpers.php -> pur_enforce_rate_limit()), but there is no reason
# for it to be reachable by URL at all.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
